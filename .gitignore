# Build outputs
build/
.work/

# Config secrets
config/build.env
config/*.key
config/*.pem

# Generated kernel config: the build writes ./.config next to the sources.
# The tracked fragment is config/kernel.config - do not confuse the two.
.config

# Leftovers from a killed merge_config.sh run
.merge_tmp.config.*
.tmp.config.*

# Packaged artifacts: built into build/ and uploaded by CI, never committed.
flash.zip

# Stray directory from an unquoted $APK_DIR in an earlier script version
$APK_DIR/

# OS files
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
*.pyo

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Results
*.log
coverage/
.nox/
