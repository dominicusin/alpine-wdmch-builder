#!/bin/sh
# install-alpine - offline Alpine Linux installer for WD My Cloud Home.
#
# ---------------------------------------------------------------------------
# DISK LAYOUT — read this before running anything
# ---------------------------------------------------------------------------
# The internal WDMCH disk ships with a FACTORY GPT holding 24 fixed
# partitions. This installer PRESERVES that table. It creates no partitions
# and never rewrites the partition table. Only ONE partition is written:
#
#   p20  SYSTEM_B   (ext4, filesystem label "wdmch-root")
#
# Why p20:
#   * It is the B / "Rescue" side of the vendor layout - the side WD's own
#     tooling treats as the safe place for a permanent alternate OS.
#   * The pinned upstream rescue init (symops/monarch-6.18 initramfs/init)
#     already probes exactly these devices for a root filesystem:
#     sda9, sda18, and sda19..sda24 (plus md arrays). p20 is in that list,
#     so the standard handoff finds the installed system.
#   * p1 (FW_TABLE), p2/p3/p4/p8/p9 (the A / B / GOLD firmware slots),
#     p18 (CONFIG) and the user's data in p22 / p24 are all left untouched.
#
# The vendor U-Boot cannot boot from the internal SATA disk at all - it only
# reads boot files from a FAT32 USB stick. So the stick stays plugged in and
# the rescue kernel pivots into the rootfs on p20 at boot. See README.kexec
# and docs/RECOVERY.md.
#
# ---------------------------------------------------------------------------
# WHAT HAPPENS HERE
# ---------------------------------------------------------------------------
#   1. verify the disk really is a WDMCH disk (factory GPT + p1/p18/p20)
#   2. back up the firmware table (p1) onto the installed system
#   3. mount p20, or mkfs.ext4 it (mke2fs is pulled from the stick on demand)
#   4. apk add alpine-base from the offline repo on the stick
#   5. copy Image + DTB into /boot, write fstab / network / console / SSH
#   6. install /usr/local/sbin/boot-full-alpine (optional kexec handoff)
#
# Usage: install-alpine <disk> [--yes] [--root-part N]
#   e.g. install-alpine /dev/sda
#        install-alpine /dev/sda --yes
#        install-alpine /dev/sda --root-part 19      # use SYSTEM_A instead
#        install-alpine /dev/sda --blank             # disk has no WDMCH GPT

set -u

DISK=""
ASSUME_YES=""
ROOT_PART=20
BLANK_DISK=0

ROOT_LABEL="wdmch-root"

# ---------------------------------------------------------------------------
usage() {
    cat <<'EOF'
usage: install-alpine <disk> [--yes] [--root-part N] [--blank]

  <disk>          whole disk node, e.g. /dev/sda (never a partition node)

  --root-part N   partition to install into (default: 20 = SYSTEM_B)
  --blank         disk has no factory WDMCH GPT: create one ext4 partition
  --yes           do not ask for confirmation

Writes ONLY the selected partition. The partition table, the firmware table
(p1) and the A/B/GOLD slots are never modified.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --yes|-y)     ASSUME_YES=1; shift ;;
        --root-part)  ROOT_PART="$2"; shift 2 ;;
        --root-part=*) ROOT_PART="${1#--root-part=}"; shift ;;
        --blank)      BLANK_DISK=1; shift ;;
        -h|--help)    usage; exit 0 ;;
        -*)           echo "ERROR: unknown option $1" >&2; usage >&2; exit 1 ;;
        *)            DISK="$1"; shift ;;
    esac
done

[ -n "$DISK" ] || { usage >&2; exit 1; }
[ -b "$DISK" ] || { echo "ERROR: $DISK is not a block device" >&2; exit 1; }
case "$DISK" in
    /dev/sd[a-z]|/dev/sd[a-z][a-z]) : ;;
    *) echo "ERROR: refusing to operate on partition node $DISK" >&2
       echo "       give the whole disk, e.g. /dev/sda" >&2
       exit 1 ;;
esac
case "$ROOT_PART" in
    ''|*[!0-9]*) echo "ERROR: --root-part must be a number" >&2; exit 1 ;;
esac

# p1 = firmware table. Refuse to ever format it, whatever --root-part says.
[ "$ROOT_PART" = "1" ] && { echo "ERROR: p1 is the firmware table - refusing" >&2; exit 1; }

# --- refuse the boot medium -------------------------------------------------------
# The rescue USB stick claims /dev/sda on this hardware (the upstream init
# notes exactly this), so a careless "install-alpine /dev/sda" would erase
# the very stick the system is running from. Detect and refuse.
stick_whole=""
# ${PROC_MOUNTS:-/proc/mounts} is a seam, not a configuration knob: unset, this
# is the real file, so shipping behaviour is unchanged. It exists so the
# refusal below can be driven against synthetic mount tables in
# tests/test_rescue_refusal.sh. This is the single most dangerous path in the
# project - if it stops working, the installer formats the stick it is running
# from - so it must be executable on a machine with no WDMCH attached.
mounts_file="${PROC_MOUNTS:-/proc/mounts}"
for part in "$DISK"1 "$DISK"2 "$DISK"3; do
    [ -b "$part" ] || continue
    if grep -qs "[[:space:]]/media/usb[[:space:]]" "$mounts_file" 2>/dev/null; then
        src=$(awk '$2 == "/media/usb" {print $1; exit}' "$mounts_file" 2>/dev/null)
        # Compare the WHOLE DISK of the mount source with the whole disk of
        # this candidate partition.
        #
        # This was a `case "$src" in "${part%[0-9]}")` with no wildcard, so
        # the pattern was the literal /dev/sda while $src is a partition node
        # like /dev/sda1. It could never match, stick_whole was never set, and
        # the guard that stops the installer from erasing the stick it is
        # running from never fired at all. Caught by
        # tests/test_rescue_refusal.sh, which is the only reason it was found
        # before someone pointed it at a live machine.
        if [ -n "$src" ] && [ "${src%[0-9]}" = "${part%[0-9]}" ]; then
            stick_whole="$part"
        fi
    fi
done
if [ -n "$stick_whole" ]; then
    echo "ERROR: $DISK is the rescue USB stick ($stick_whole is mounted at /media/usb)." >&2
    echo "       Installing would erase the boot medium you are running from." >&2
    echo "       Pick the internal SATA disk instead - the rescue banner names it." >&2
    exit 1
fi
# A rescue stick always carries our own boot files at its root.
for part in "$DISK"1 "$DISK"2 "$DISK"3; do
    [ -b "$part" ] || continue
    mkdir -p /tmp/.probe
    if mount -t vfat -o ro "$part" /tmp/.probe 2>/dev/null; then
        if [ -f /tmp/.probe/sata.uImage ] && [ -f /tmp/.probe/rescue.sata.dtb ]; then
            umount /tmp/.probe 2>/dev/null
            rmdir /tmp/.probe 2>/dev/null
            echo "ERROR: $part holds a WDMCH rescue stick (sata.uImage + rescue.sata.dtb)." >&2
            echo "       Refusing to install over the boot medium." >&2
            exit 1
        fi
        umount /tmp/.probe 2>/dev/null
    fi
    rmdir /tmp/.probe 2>/dev/null
done

USB_ROOT=/media/usb
APKS_DIR="$USB_ROOT/apks"
[ -d "$APKS_DIR" ] || {
    echo "ERROR: $APKS_DIR not found - is the rescue USB stick mounted?" >&2
    echo "       the stick must contain apks/main and apks/community" >&2
    exit 1
}

log() { echo "[install] $*"; }
die() { echo "ERROR: $*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# 1. identify the disk
# ---------------------------------------------------------------------------
log "inspecting $DISK ..."
echo "  partitions currently visible:"
cat /proc/partitions | sed 's/^/    /'

has_gpt=0
if [ -b "${DISK}1" ] && [ -b "${DISK}20" ] && [ -b "${DISK}18" ]; then
    has_gpt=1
fi

if [ "$has_gpt" = "1" ] && [ "$BLANK_DISK" = "0" ]; then
    log "factory WDMCH partition table detected (p1, p18, p20 present)"
    for p in 1 2 3 9 18; do
        [ -b "${DISK}${p}" ] || log "WARN: expected ${DISK}${p} is missing"
    done
else
    if [ "$BLANK_DISK" = "0" ]; then
        echo ""
        echo "ERROR: $DISK does not look like a WDMCH disk." >&2
        echo "       Expected the factory GPT (p1 FW_TABLE, p18 CONFIG, p20 SYSTEM_B)." >&2
        echo "       Refusing to touch an unrecognised disk." >&2
        echo "       If this really is a blank disk, re-run with --blank" >&2
        exit 1
    fi
    log "--blank: no factory GPT, will create a single ext4 partition"
fi

# On the factory table, only SYSTEM_A and SYSTEM_B may be written.
#
# The only previous restriction was p1 (:94) plus a `19|20` allowlist deeper
# down that was reached ONLY when the target partition already held ext4. So
# `--root-part 9` against a GOLD firmware slot that did not happen to contain
# ext4 would have been formatted, contradicting this script's own header,
# which promises the A/B/GOLD slots are never modified. The allowlist belongs
# here, where the partition table is already known, not behind a filesystem
# probe.
if [ "$has_gpt" = "1" ] && [ "$BLANK_DISK" = "0" ]; then
    case "$ROOT_PART" in
        19|20) : ;;
        *) echo "ERROR: refusing to write partition $ROOT_PART." >&2
           echo "       On the factory table only p19 (SYSTEM_A) and p20" >&2
           echo "       (SYSTEM_B) may be written. p1 holds the firmware table," >&2
           echo "       p2-p9 the A/B/GOLD firmware slots, p18 CONFIG, and" >&2
           echo "       p22/p24 hold user data." >&2
           exit 1 ;;
    esac
fi

ROOT_DEV="${DISK}${ROOT_PART}"
[ "$has_gpt" = "1" ] || ROOT_DEV="${DISK}1"

# ---------------------------------------------------------------------------
# 2. confirmation
# ---------------------------------------------------------------------------
if [ "$ASSUME_YES" != "1" ]; then
    echo ""
    echo "About to install Alpine Linux."
    echo "  disk          : $DISK"
    if [ "$has_gpt" = "1" ]; then
        echo "  will write    : $ROOT_DEV (partition $ROOT_PART) ONLY"
    else
        echo "  will CREATE   : one partition on $DISK (no WDMCH GPT present)"
    fi
    echo "  will NOT touch: partition table, p1 firmware table, A/B/GOLD slots"
    echo "  label         : $ROOT_LABEL"
    echo ""
    printf "Type YES to continue: "
    read -r answer
    [ "$answer" = "YES" ] || { echo "aborted"; exit 1; }
fi

# ---------------------------------------------------------------------------
# 2b. firmware table backup (p1) - BEFORE the first destructive write
# ---------------------------------------------------------------------------
# This belongs here. The header above describes it as step 2 and the release
# checklist says "backed up before any write", but it used to sit at step 5,
# after mke2fs had already reformatted p20. A backup taken after the write it
# was meant to precede is not a backup.
#
# The copy is made to /tmp in the initramfs and placed on the target later,
# once the target is mounted.
#
# A failed read is now fatal. It used to be a WARN, which is the worst possible
# outcome: the operator is told the install succeeded, has no firmware-table
# copy, and finds that out only if the unit later fails to boot. The result is
# also checked non-empty, because dd can exit 0 having written nothing.
if [ "$has_gpt" = "1" ]; then
    log "backing up the firmware table (${DISK}1) before any write ..."
    FW_BACKUP=/tmp/wdmch-fw-table-backup.bin
    rm -f "$FW_BACKUP"
    if dd if="${DISK}1" of="$FW_BACKUP" bs=512 2>/dev/null && [ -s "$FW_BACKUP" ]; then
        log "  saved $(stat -c%s "$FW_BACKUP") bytes to $FW_BACKUP"
    else
        echo "" >&2
        echo "ERROR: could not read the firmware table from ${DISK}1." >&2
        echo "       Refusing to continue. The firmware table is the one partition" >&2
        echo "       the vendor loader depends on; a backup that failed silently" >&2
        echo "       would leave no way back if the unit stopped booting." >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# 3. stop anything using the disk
# ---------------------------------------------------------------------------
log "unmounting anything already mounted from $DISK ..."
for m in $(awk -v d="$DISK" '$1 ~ "^"d {print $2}' /proc/mounts 2>/dev/null); do
    umount -f "$m" 2>/dev/null || true
done
swapoff -a 2>/dev/null || true

# ---------------------------------------------------------------------------
# 4. make sure $ROOT_DEV is an ext4 we can write to
# ---------------------------------------------------------------------------
# busybox blkid only prints UUIDs - no -s/-o. Use findfs for label lookups
# and a real read-only mount to find out what is actually on the partition.
MNT=/mnt/install
mkdir -p "$MNT"

already_ours=0
if [ -b "$ROOT_DEV" ] && [ "$(findfs "LABEL=$ROOT_LABEL" 2>/dev/null)" = "$ROOT_DEV" ]; then
    already_ours=1
fi

has_ext4=0
if [ "$already_ours" = "0" ] && [ -b "$ROOT_DEV" ]; then
    if mount -t ext4 -o ro "$ROOT_DEV" "$MNT" 2>/dev/null; then
        has_ext4=1
        umount "$MNT" 2>/dev/null || true
    fi
fi

# mke2fs is NOT in busybox-static. Pull e2fsprogs from the offline repo on
# the stick into tmpfs on demand - keeps the 4 MiB initramfs lean.
E2FSDIR=/tmp/e2fs
have_mke2fs() { [ -x "$E2FSDIR/sbin/mke2fs" ]; }

load_mke2fs() {
    have_mke2fs && return 0
    log "mke2fs is not in busybox - unpacking e2fsprogs from the stick ..."
    rm -rf "$E2FSDIR"
    mkdir -p "$E2FSDIR"
    APK=/sbin/apk.static
    [ -x "$APK" ] || APK=/usr/sbin/apk.static
    [ -x "$APK" ] || { echo "ERROR: apk.static not found in the initramfs" >&2; return 1; }
    [ -d /etc/apk/keys ] || { echo "ERROR: /etc/apk/keys missing" >&2; return 1; }
    "$APK" add --root "$E2FSDIR" --initdb \
        --repository "file://$APKS_DIR/main" \
        --repository "file://$APKS_DIR/community" \
        --keys-dir /etc/apk/keys \
        --no-cache --no-scripts e2fsprogs >/dev/null 2>&1 || {
            echo "ERROR: could not install e2fsprogs from $APKS_DIR" >&2
            echo "       the offline repo on the stick is incomplete -" >&2
            echo "       rebuild flash.zip so it carries e2fsprogs + its libs" >&2
            return 1
        }
    [ -f "$E2FSDIR/etc/mke2fs.conf" ] && cp "$E2FSDIR/etc/mke2fs.conf" /etc/mke2fs.conf 2>/dev/null
    have_mke2fs || { echo "ERROR: e2fsprogs unpacked but $E2FSDIR/sbin/mke2fs missing" >&2; return 1; }
    log "e2fsprogs ready at $E2FSDIR"
    return 0
}

run_mke2fs() {
    target="$1"
    load_mke2fs || return 1
    LD_LIBRARY_PATH="$E2FSDIR/usr/lib:$E2FSDIR/lib:$E2FSDIR/usr/lib/musl" \
        "$E2FSDIR/sbin/mke2fs" -q -t ext4 -L "$ROOT_LABEL" -F "$target"
}

MNT=/mnt/install
mkdir -p "$MNT"
mounted=0

if [ "$has_gpt" = "0" ]; then
    # Blank disk: one ext4 partition across the whole device. busybox fdisk
    # is MBR-only and that is fine - nothing on this platform reads the
    # partition table; the rescue init finds the rootfs by filesystem label.
    log "partitioning $DISK (one primary partition, ext4) ..."
    fdisk "$DISK" >/dev/null 2>&1 <<'FDISKEOF' || die "fdisk failed on $DISK"
o
n
p
1
1

t
1
83
w
FDISKEOF
    partprobe "$DISK" 2>/dev/null || true
    mdev -s 2>/dev/null || true
    sleep 2
    ROOT_DEV="${DISK}1"
    [ -b "$ROOT_DEV" ] || die "$ROOT_DEV did not appear after partitioning"
    log "formatting $ROOT_DEV ..."
    run_mke2fs "$ROOT_DEV" || die "mke2fs failed on $ROOT_DEV"
else
    # Factory disk: reuse the partition in place. Never touch the table.
    if [ "$already_ours" = "1" ]; then
        log "$ROOT_DEV already carries label $ROOT_LABEL - reusing it"
    elif [ "$has_ext4" = "1" ]; then
        # The partition number was already restricted to 19/20 above, where
        # the partition table is known. This branch only has to say what it is
        # about to do.
        log "$ROOT_DEV holds an existing ext4 filesystem - reformatting with label $ROOT_LABEL"
        run_mke2fs "$ROOT_DEV" || die "mke2fs failed on $ROOT_DEV"
    else
        log "formatting $ROOT_DEV ..."
        run_mke2fs "$ROOT_DEV" || die "mke2fs failed on $ROOT_DEV"
    fi
fi

partprobe "$DISK" 2>/dev/null || true
mdev -s 2>/dev/null || true
sleep 1

mount -t ext4 "$ROOT_DEV" "$MNT" || die "cannot mount $ROOT_DEV"
mounted=1

# Clear whatever was on it - a stale rootfs here would confuse the handoff.
log "clearing old content on $ROOT_DEV ..."
for entry in bin boot dev etc home lib media mnt opt proc root run sbin srv sys tmp usr var; do
    [ -e "$MNT/$entry" ] && rm -rf "${MNT:?}/$entry"
done
mkdir -p "$MNT"/{proc,sys,dev,run,tmp,root,mnt,media,boot,etc}

# ---------------------------------------------------------------------------
# 5. place the pre-write firmware table backup on the target
# ---------------------------------------------------------------------------
# Reused from step 2b rather than read again. Re-reading here would take a
# second copy AFTER p20 was already formatted, which is the defect step 2b was
# moved to fix.
if [ "$has_gpt" = "1" ]; then
    if [ -s "$FW_BACKUP" ]; then
        mkdir -p "$MNT/root"
        cp -f "$FW_BACKUP" "$MNT/root/wdmch-fw-table-backup.bin" \
            || die "could not place the firmware table backup on the target"
        log "  firmware table backup placed at /root/wdmch-fw-table-backup.bin ($(stat -c%s "$MNT/root/wdmch-fw-table-backup.bin" 2>/dev/null || echo '?') bytes)"
    else
        die "internal: the pre-write firmware table backup disappeared"
    fi
fi

# ---------------------------------------------------------------------------
# 6. base system from the stick
# ---------------------------------------------------------------------------
log "installing the Alpine base system from $APKS_DIR (offline) ..."
APK=/sbin/apk.static
[ -x "$APK" ] || APK=/usr/sbin/apk.static
[ -x "$APK" ] || die "apk.static not found in the initramfs"
[ -d /etc/apk/keys ] || die "/etc/apk/keys missing"

# NOTE: --no-scripts must NOT be used here.
#
# busybox's .post-install runs `busybox --install -s`, which is what creates
# the applet symlinks - including /sbin/init. Its .PKGINFO also declares
# triggers on /bin /usr/bin /sbin /usr/sbin. apk skips both package scripts
# and triggers under --no-scripts, so an install made that way has no init at
# all: 99-disk-root would refuse to hand over and the box would never boot
# again. (--no-scripts IS correct for the throwaway e2fsprogs pull below,
# where only the shared libraries matter.)
"$APK" add \
    --root "$MNT" \
    --initdb \
    --repository "file://$APKS_DIR/main" \
    --repository "file://$APKS_DIR/community" \
    --keys-dir /etc/apk/keys \
    --no-cache \
    alpine-base openrc-init ifupdown-ng dropbear 2>&1 | tail -5 || die "apk add failed"

# Verify the install is actually bootable and networked before declaring
# success. A rootfs with no init can never be handed over to (99-disk-root
# looks for exactly these paths and refuses anything else), and a rootfs with
# no ifup comes up with no network - both are silent failures otherwise.
echo ""
echo "[install] verifying the installed system ..."
verify_failed=0
have_init=""
init_note=""
for i in sbin/init init usr/sbin/init lib/systemd/systemd usr/lib/systemd/systemd; do
    if [ -x "$MNT/$i" ]; then have_init="$i"; break; fi
done
if [ -z "$have_init" ]; then
    # Self-heal rather than leave a brick. Alpine's /sbin/init is normally a
    # symlink to busybox created by busybox's .post-install
    # (`busybox --install -s`). We deliberately run package scripts, but do
    # NOT rely on that alone: recreate the link explicitly so an install can
    # never end up with a rootfs that cannot boot.
    bb=""
    for b in bin/busybox sbin/busybox usr/bin/busybox usr/sbin/busybox; do
        [ -x "$MNT/$b" ] && { bb="$b"; break; }
    done
    if [ -n "$bb" ]; then
        mkdir -p "$MNT/sbin"
        ln -sf "/$bb" "$MNT/sbin/init"
        if [ -x "$MNT/sbin/init" ]; then
            have_init="sbin/init"
            init_note="(created -> /$bb; busybox provides the init applet)"
        fi
    fi
fi
if [ -z "$have_init" ]; then
    echo "  FAIL: no init binary in the installed system"
    echo "        looked for sbin/init, init, usr/sbin/init, lib/systemd/systemd"
    echo "        and found no busybox to symlink it to"
    echo "        the offline repo is probably missing openrc-init - rebuild flash.zip"
    verify_failed=1
else
    echo "  init:      /$have_init $init_note"
fi
if [ -x "$MNT/sbin/ifup" ] || [ -x "$MNT/usr/sbin/ifup" ]; then
    echo "  ifupdown:  present"
else
    echo "  FAIL: no ifup - the networking service cannot bring up eth0"
    echo "        the offline repo is probably missing ifupdown-ng - rebuild flash.zip"
    verify_failed=1
fi
if [ -x "$MNT/usr/sbin/dropbear" ] || [ -x "$MNT/sbin/dropbear" ]; then
    echo "  dropbear:  present"
else
    echo "  FAIL: no dropbear - SSH will not work after the handoff"
    verify_failed=1
fi
if [ "$verify_failed" -ne 0 ]; then
    die "the installed system is not usable - see the failures above"
fi

# ---------------------------------------------------------------------------
# 7. kernel + DTB into /boot
# ---------------------------------------------------------------------------
log "copying the kernel and DTB from the stick into /boot ..."
mkdir -p "$MNT/boot"

if [ -f "$USB_ROOT/sata.uImage" ]; then
    cp "$USB_ROOT/sata.uImage" "$MNT/boot/Image" \
        && log "  sata.uImage -> /boot/Image ($(stat -c%s "$MNT/boot/Image") bytes)"
else
    die "$USB_ROOT/sata.uImage not found - the installed system would have no kernel to boot"
fi

if [ -f "$USB_ROOT/rescue.sata.dtb" ]; then
    cp "$USB_ROOT/rescue.sata.dtb" "$MNT/boot/rtd1295-wd-mycloud-home.dtb" \
        && log "  rescue.sata.dtb -> /boot/rtd1295-wd-mycloud-home.dtb"
else
    die "$USB_ROOT/rescue.sata.dtb not found - the installed system would have no device tree to boot"
fi

# Both were WARNs. An install that completes without a kernel or without a
# DTB leaves a filesystem that cannot boot, and reports success while doing it.
# That is the same fail-open shape as the firmware-table backup and the SSH
# key: the operator is told it worked, and finds out at the next reboot.

# The rescue initramfs itself is NOT a usable initrd for the installed system
# (it is a fixed 4 MiB rescue image whose /init is the rescue script). Do not
# copy it - boot-full-alpine kexecs the kernel with no ramdisk and lets the
# kernel mount the rootfs directly, which works because EXT4 is built in.

# ---------------------------------------------------------------------------
# 8. system configuration
# ---------------------------------------------------------------------------
log "writing system configuration ..."

cat > "$MNT/etc/fstab" <<EOF
# WDMCH Alpine install
# The vendor U-Boot cannot boot from this disk; boot files come from the
# FAT32 rescue stick and this rootfs is entered by the rescue init.
LABEL=$ROOT_LABEL  /      ext4  defaults,noatime  0 1
tmpfs              /tmp   tmpfs defaults          0 0
debugfs            /sys   sysfs  defaults          0 0
proc               /proc  proc   defaults          0 0
EOF

mkdir -p "$MNT/etc/network"
cat > "$MNT/etc/network/interfaces" <<'EOF'
auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
EOF

echo "wdmch" > "$MNT/etc/hostname"

cat > "$MNT/etc/inittab" <<'EOF'
::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default
ttyS0::respawn:/sbin/getty -L ttyS0 115200 vt100
::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
EOF

cat > "$MNT/etc/rc.conf" <<'EOF'
rc_parallel="NO"
rc_verbose="NO"
EOF

mkdir -p "$MNT/etc/runlevels/default"
for svc in networking dropbear crond syslog; do
    [ -e "$MNT/etc/init.d/$svc" ] && ln -sf "/etc/init.d/$svc" "$MNT/etc/runlevels/default/$svc"
done

# SSH: same public key as the rescue image, no password anywhere.
#
# A missing key is fatal, not a warning. This is the ONLY way in: there is no
# root password, the console is the sole alternative, and the operator is
# standing at a serial console with a freshly formatted p20. The verification
# block below checks that dropbear exists but never checked that a key arrived,
# so "installed successfully" could have meant a system nobody can log into.
if [ -s /root/.ssh/authorized_keys ]; then
    mkdir -p "$MNT/root/.ssh"
    cp /root/.ssh/authorized_keys "$MNT/root/.ssh/authorized_keys"
    chmod 700 "$MNT/root/.ssh"
    chmod 600 "$MNT/root/.ssh/authorized_keys"
    if [ -s "$MNT/root/.ssh/authorized_keys" ]; then
        log "  installed the rescue SSH public key into /root/.ssh/authorized_keys"
    else
        die "the SSH key did not survive the copy onto the target"
    fi
else
    echo "" >&2
    echo "ERROR: no authorized_keys in the rescue image." >&2
    echo "       Refusing to report a successful install: there is no root" >&2
    echo "       password, so without this key the installed system cannot be" >&2
    echo "       reached over SSH and the only way in is the serial console." >&2
    echo "       Build the rescue image with WDMCH_SSH_AUTHORIZED_KEY set." >&2
    exit 1
fi

# Marker the rescue init looks for before handing over to this system.
mkdir -p "$MNT/etc"
cat > "$MNT/etc/wdmch-installed" <<EOF
root_dev=$ROOT_DEV
root_label=$ROOT_LABEL
installed_by=install-alpine
EOF

# Ship the post-install health check onto the target. The build cannot verify
# the handover, the network or the partition table without real hardware, so
# give the operator one command to run once the box has booted.
if [ -f /usr/local/sbin/verify-install ]; then
    mkdir -p "$MNT/usr/local/sbin"
    cp /usr/local/sbin/verify-install "$MNT/usr/local/sbin/verify-install"
    chmod 755 "$MNT/usr/local/sbin/verify-install"
    log "  installed /usr/local/sbin/verify-install (run it after the first boot)"
fi

# ---------------------------------------------------------------------------
# 9. optional kexec handoff (lets the stick be pulled after first boot)
# ---------------------------------------------------------------------------
log "installing /usr/local/sbin/boot-full-alpine (kexec handoff) ..."
mkdir -p "$MNT/usr/local/sbin"
cat > "$MNT/usr/local/sbin/boot-full-alpine" <<'KEXEC_EOF'
#!/bin/sh
# boot-full-alpine - kexec into the kernel stored on the internal disk.
#
# The vendor U-Boot can only read boot files from a FAT32 USB stick, so the
# normal boot is: stick -> rescue kernel -> switch_root into this system.
# This script is the optional alternative: it loads /boot/Image with kexec
# so the NEXT boot goes straight to this system without the stick.
#
# Usage:
#   boot-full-alpine          prepare the kexec, print the command to run
#   boot-full-alpine --exec   prepare and execute immediately (kexec -e)
set -u
ROOT_DEV=$(sed -n 's/^root_dev=//p' /etc/wdmch-installed 2>/dev/null)
[ -n "$ROOT_DEV" ] || ROOT_DEV=$(findfs LABEL=wdmch-root 2>/dev/null)
KERNEL=/boot/Image
DTB=/boot/rtd1295-wd-mycloud-home.dtb

[ -f "$KERNEL" ] || { echo "ERROR: $KERNEL not found" >&2; exit 1; }
[ -f "$DTB" ]    || { echo "ERROR: $DTB not found" >&2; exit 1; }
command -v kexec >/dev/null 2>&1 || { echo "ERROR: kexec not installed" >&2; exit 1; }

# No --ramdisk: EXT4 and the AHCI/SATA drivers are built into this kernel, so
# it can mount the rootfs itself. The rescue initramfs is NOT usable here.
kexec -l "$KERNEL" \
      --dtb "$DTB" \
      --command-line="root=$ROOT_DEV rootfstype=ext4 rw console=ttyS0,115200 earlycon=uart8250,mmio32,0x98007800 panic=5" \
    || { echo "ERROR: kexec -l failed" >&2; exit 1; }

echo "kexec entry prepared."
if [ "${1:-}" = "--exec" ]; then
    echo "executing now ..."
    kexec -e
else
    echo "Run 'kexec -e' to reboot into the on-disk kernel, or reboot and"
    echo "reboot again (the entry is not persistent across a normal reboot)."
fi
KEXEC_EOF
chmod 755 "$MNT/usr/local/sbin/boot-full-alpine"

# ---------------------------------------------------------------------------
# 10. wrap up
# ---------------------------------------------------------------------------
rm -rf "$MNT/var/cache/apk"/* 2>/dev/null || true
rm -rf "$E2FSDIR" 2>/dev/null || true
sync

echo ""
echo "installed packages:"
"$APK" list --root "$MNT" 2>/dev/null | head -15 || true

sync
umount "$MNT" 2>/dev/null || die "could not unmount $MNT"
mounted=0

cat <<EOF

============================================================
 Alpine Linux installed to $ROOT_DEV  (label $ROOT_LABEL)
============================================================

 Boot:
   1. Leave the USB stick plugged in.
   2. Hold reset while powering on (or just power on - the loader falls
      back to the USB rescue path when no factory partition is found).
   3. The rescue kernel hands over to this system automatically.

 To get a rescue shell instead of the installed system:
      touch norescue          # file in the ROOT of the USB stick

 SSH:  ssh root@<dhcp-lease-ip>     (public-key only, no password)

 Firmware table backup: /root/wdmch-fw-table-backup.bin
 Partition table, p1 and the A/B/GOLD slots were NOT modified.

 Optional - boot without the stick after this first successful boot:
      /usr/local/sbin/boot-full-alpine --exec
============================================================

EOF
