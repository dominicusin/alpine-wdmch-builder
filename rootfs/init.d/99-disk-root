#!/bin/sh
# 99-disk-root - hand over from the rescue initramfs to the installed system.
#
# Run by /init after networking and SSH are up. Finds the ext4 filesystem
# labelled "wdmch-root" (written by install-alpine into p20 / SYSTEM_B),
# verifies it really is a bootable system, and switch_root()s into it.
#
# Everything here is best-effort: any failure leaves the rescue shell intact,
# which is the whole point of a rescue image.
#
# ESCAPE HATCH
#   touch norescue        (in the ROOT of the USB stick)
# skips the handoff and drops to the rescue shell instead. The marker is
# one-shot-safe to remove: delete the file and the next boot hands over.

# Overridable so the decision logic can be tested without root, a mount
# namespace or the real hardware - see tests/test_handoff.sh. The defaults are
# the production values; nothing in the rescue image overrides them.
ROOT_LABEL=${ROOT_LABEL:-wdmch-root}
NEWROOT=${NEWROOT:-/newroot}
USB_ROOT=${USB_ROOT:-/media/usb}

# btrfs needs the subvolume at mount time. It cannot be read from the installed
# system before that system is mounted, which is exactly why the installer puts
# the system in the TOP-LEVEL subvolume: this default is then always correct and
# the label alone identifies the filesystem. Overridable only for a future
# install that uses a named subvolume.
ROOT_SUBVOL=${ROOT_SUBVOL:-/}
# The btrfs mount options, defined ONCE. Both mount paths - the label lookup and
# the fallback scan - must agree: compress= sets the DEFAULT compression for new
# writes, so a root found by the scan was silently uncompressed while the same
# root found by its label was compressed. That difference would depend on which
# path ran, not on what was installed.
#
# compress=zstd is safe to request unconditionally: in 6.18 CONFIG_BTRFS_FS
# itself selects ZSTD_COMPRESS/ZSTD_DECOMPRESS, so asking for btrfs already
# brings zstd with it. It is a default for new writes, never a mount failure -
# an existing filesystem mounts whether or not it is given.
BTRFS_MOUNT_OPTS=${BTRFS_MOUNT_OPTS:-subvol=${ROOT_SUBVOL:-/},compress=zstd}
MOUNTS=${MOUNTS:-/proc/mounts}
RESCUE_SSH_KEY=${RESCUE_SSH_KEY:-/root/.ssh/authorized_keys}

kmsg() { echo "<6>wdmch-rescue: $*" > /dev/kmsg 2>/dev/null; }
say()  { echo "[handoff] $*"; kmsg "$*"; }

is_mounted() { grep -qs "[[:space:]]$1[[:space:]]" "$MOUNTS"; }

# --- escape hatch ------------------------------------------------------------
if [ -f "$USB_ROOT/norescue" ]; then
    say "norescue marker on the USB stick - staying in the rescue shell"
    say "delete $USB_ROOT/norescue to hand over to the installed system"
    exit 0
fi

# --- find the root filesystem -------------------------------------------------
# Primary: the filesystem label. Independent of which /dev/sd? letter or
# partition number the kernel ends up assigning.
candidate=""
if command -v findfs >/dev/null 2>&1; then
    candidate=$(findfs "LABEL=$ROOT_LABEL" 2>/dev/null)
fi

# Fallback for an unlabelled system.
#
# This existed because install-alpine always writes the wdmch-root label, so an
# UNLABLED candidate can only be something install-alpine did not create - which
# on a WDMCH means a factory slot. docs/RECOVERY.md is explicit:
#
#     DO NOT boot the GOLD partition. GOLD is a factory-reset appliance,
#     not a safe fallback.
#
# and this loop listed /dev/sda9 - ROOTFS_GOLD - in the scan. If GOLD mounted as
# ext4 and carried an init, the rescue image would have switch_root'd into the
# one slot the operator was told never to boot. Nothing else would have caught
# it: the refusal to write GOLD is an installer guard, and this is the boot
# path, which runs no such check.
#
# The scan is therefore restricted to partitions that are not vendor slots. The
# GOLD entry is gone, and every candidate is additionally checked against its
# PARTLABEL so a future slot cannot be reintroduced by adding a line here.
if [ -z "$candidate" ]; then
  say "no filesystem labelled $ROOT_LABEL - scanning the WDMCH layout"
# SCAN_PARTS is overridable for the same reason MOUNTS is: the loop below tests
# `[ -b "$p" ]`, which no synthetic path can satisfy, so the scan was previously
# unreachable from a test - the one path that mounts WITHOUT the label was the
# one path nothing could execute.
for p in ${SCAN_PARTS:-/dev/sda20 /dev/sda19 /dev/sda21 /dev/sda22 /dev/sda24}; do
    [ -b "$p" ] || continue
    [ "$p" = "$candidate" ] && continue
    plabel=""
    if command -v blkid >/dev/null 2>&1; then
        plabel=$(blkid -s PARTLABEL -o value "$p" 2>/dev/null || true)
    fi
    case "$plabel" in
        ""|SYSTEM_B|SYSTEM_A) : ;;                       # not a factory slot
        *) say "skipping $p (PARTLABEL '$plabel' is a vendor slot)"
           continue ;;
    esac
    if mkdir -p "$NEWROOT" \
       && { mount -t btrfs -o "$BTRFS_MOUNT_OPTS" "$p" "$NEWROOT" 2>/dev/null \
            || mount -t ext4 "$p" "$NEWROOT" 2>/dev/null; }; then
        if [ -x "$NEWROOT/sbin/init" ] || [ -x "$NEWROOT/init" ] \
           || [ -x "$NEWROOT/usr/sbin/init" ] || [ -x "$NEWROOT/lib/systemd/systemd" ]; then
            candidate="$p"
            break
        fi
        umount "$NEWROOT" 2>/dev/null
    fi
done
fi

if [ -z "$candidate" ]; then
    say "no installed system found - staying in the rescue shell"
    say "(expected a btrfs filesystem labelled $ROOT_LABEL across p20 + p21)"
    exit 0
fi

# --- mount and verify ---------------------------------------------------------
# The installed system is ONE btrfs spanning p20 + p21. A multi-device btrfs is
# mounted through ANY one of its members - the filesystem metadata records the
# rest - so the candidate device is enough; listing both would mount the same
# filesystem twice. That is why fstab names the label and not both devices.
#
# It mounts with -t btrfs now, not -t ext4. Leaving ext4 there meant a btrfs
# install could never hand over at all: the mount failed, the script printed
# "cannot mount ... staying in the rescue shell", and the operator was left
# staring at a rescue shell on a machine that had installed perfectly well.
mkdir -p "$NEWROOT"
if ! is_mounted "$NEWROOT"; then
    if ! mount -t btrfs -o "$BTRFS_MOUNT_OPTS" "$candidate" "$NEWROOT" 2>/dev/null; then
        # Fall back to auto-detection rather than giving up: an older install
        # from before the btrfs change is still ext4.
        if ! mount -t ext4 "$candidate" "$NEWROOT" 2>/dev/null; then
            say "cannot mount $candidate - staying in the rescue shell"
            exit 0
        fi
    fi
fi

# A degraded multi-device filesystem is exactly the failure this handover has
# to notice: if one member is missing the filesystem still mounts, the system
# still boots, and the loss is invisible until something tries to write.
if [ -w "$NEWROOT" ] && command -v btrfs >/dev/null 2>&1; then
    deg=$(btrfs filesystem show "$NEWROOT" 2>/dev/null | grep -ci 'missing' || true)
    [ "${deg:-0}" -gt 0 ] && say "WARNING: the btrfs is DEGRADED - a member device is missing"
fi

init=""
for i in /sbin/init /init /usr/sbin/init /lib/systemd/systemd /usr/lib/systemd/systemd; do
    if [ -x "$NEWROOT$i" ]; then init="$i"; break; fi
done

if [ -z "$init" ]; then
    say "$candidate has no usable init - not an installed system"
    say "staying in the rescue shell"
    umount "$NEWROOT" 2>/dev/null
    exit 0
fi

say "found installed system on $candidate (init $init)"

# --- prep the new root's mounts ----------------------------------------------
mkdir -p "$NEWROOT/proc" "$NEWROOT/sys" "$NEWROOT/dev" "$NEWROOT/run"
is_mounted "$NEWROOT/proc" || mount -t proc proc "$NEWROOT/proc"
is_mounted "$NEWROOT/sys"  || mount -t sysfs sysfs "$NEWROOT/sys"
is_mounted "$NEWROOT/dev"  || mount -o bind /dev "$NEWROOT/dev"
if [ -d /run ]; then
    is_mounted "$NEWROOT/run" || mount -o bind /run "$NEWROOT/run"
fi

# Carry the SSH authorized key across so the installed system stays reachable
# even if the copy made by install-alpine went missing.
#
# This is a safety net, not a convenience. install-alpine now makes a missing
# key FATAL, so a target without one means someone removed it after the fact,
# and this undoes that. That is the right trade: losing SSH to a device whose
# only access is SSH and a serial console is worse than an extra key being
# present. But a key from removable media has just become a persistent
# credential on the internal disk, so it says so plainly and says how to undo
# it, rather than appearing as a side effect.
if [ -f "$RESCUE_SSH_KEY" ] && [ ! -f "$NEWROOT/root/.ssh/authorized_keys" ]; then
    mkdir -p "$NEWROOT/root/.ssh"
    if cp "$RESCUE_SSH_KEY" "$NEWROOT/root/.ssh/authorized_keys" 2>/dev/null; then
        chmod 700 "$NEWROOT/root/.ssh" 2>/dev/null
        chmod 600 "$NEWROOT/root/.ssh/authorized_keys" 2>/dev/null
        say "WARNING: the installed system had NO SSH key, so the RESCUE key was"
        say "         copied into it. The rescue key now persists on the internal"
        say "         disk even without the stick. If that is not what you want,"
        say "         remove $NEWROOT/root/.ssh/authorized_keys after this boot."
        say "         (install-alpine now refuses to complete without a key, so"
        say "          this only fires if the key was deleted deliberately.)"
    fi
fi

# --- hand over ----------------------------------------------------------------
say "switch_root $NEWROOT $init - the USB stick can stay plugged in"
say "touch $USB_ROOT/norescue before the next boot to get the rescue shell back"
sync

exec switch_root -c /dev/console "$NEWROOT" "$init"
