# WDMCH Kernel Configuration
# Based on symops/monarch-6.18 WDMCH port
# Generated from verified source; do not blindly add random config options
# to an unknown kernel tree. Only add options that are verified present
# in the defconfig or explicitly required by the WDMCH platform.

# Realtek RTD129x platform
CONFIG_ARCH_REALTEK=y
CONFIG_ARCH_RTD129x=y
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AHCI_RTD1295=y
CONFIG_SATA_HOST=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_R8169SOC=y
CONFIG_PHY_RTK_RTD_SATAPHY=y
CONFIG_KEXEC_CORE=y
CONFIG_KEXEC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_SCSI=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_PHYLIB=y
CONFIG_PSI=y
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_RCU=y
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
# CONFIG_RCU_LAZY is not set
CONFIG_RCU_CPU_STALL_TIMEOUT=60

# CMA (Contiguous Memory Allocator) - required for cma_diag_race_shift_calls
CONFIG_CMA=y
CONFIG_CMA_MIGRATION=y
CONFIG_CMA_DEBUGFS=y
EOF