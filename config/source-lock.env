# Source lock file for alpine-wdmch-builder
# These references are immutable and must not float in CI

KERNEL_REPO=https://github.com/symops/monarch-6.18.git
# Reviewed commit. Linux v6.18.52 base + the RTD1295 "Monarch" board port
# (rtd1295-wd-mycloud-home.dts, ahci_rtd1295, phy-rtk-sata, r8169soc,
# wdmc-poweroff, and the /memreserve/ + linux,initrd-* rescue contract that
# places the 4 MiB initramfs at 0x02200000).
# kernel/fetch-kernel.sh fetches exactly this commit and refuses to float;
# it must be a full SHA, never a branch name.
KERNEL_REF=9c6044def2992244f167753803d9a3aa0c0410b8
FIREBLOSSOM_REPO=https://github.com/Fireblossom/wd-mch-kernel.git
WDMC_TOOLS_REPO=https://github.com/sgissi/wdmch-tools.git
ALPINE_ARCH=aarch64
