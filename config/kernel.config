# WDMCH Kernel Configuration
# Based on symops/monarch-6.18 WDMCH port
# Generated from verified source; do not blindly add options not in the source tree

CONFIG_ARCH_REALTEK=y
CONFIG_ARCH_RTD129x=y
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AHCI_RTD1295=y
CONFIG_SATA_HOST=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_R8169SOC=y
CONFIG_PHY_RTK_RTD_SATAPHY=y
CONFIG_KEXEC_CORE=y
CONFIG_KEXEC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_SCSI=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_PHYLIB=y

# RCU and Preemption
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_RCU=y
CONFIG_RCU_EXPERT=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
# CONFIG_RCU_LAZY is not set
CONFIG_RCU_CPU_STALL_TIMEOUT=60
CONFIG_PSI=y

# Additional required WDMCH options
CONFIG_HOTPLUG=y
CONFIG_HOTPLUG_CPU=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y

# Network
CONFIG_NET_SCHED=y
CONFIG_NET_CLS=y
CONFIG_NET_CLS_FW=y
CONFIG_NET_ACT=y
CONFIG_INET=y
CONFIG_INET_UDP_DIAG=y

# Storage
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_SCAN_ASYNC=y
CONFIG_SCSI_CONSTANTS=y

# Debug
CONFIG_DEBUG_KERNEL=y
CONFIG_MAGIC_SYSRQ=y

# Clang cross-compilation support
CONFIG_CC_IS_CLANG=y
CONFIG_CLANG_VERSION=21
