# WDMCH Rescue Kernel Configuration Fragment
# Merged on top of arm64 defconfig via scripts/kconfig/merge_config.sh
#
# Rules (per docs/SOURCES.md verification policy):
#  - symops/monarch-6.18 is the PRIMARY source for all kernel code
#  - only symbols verified present in this tree are used
#  - everything the rescue initramfs needs is built-in (=y), not modules
#
# Board: WD My Cloud Home, Realtek RTD1295 (4x Cortex-A53, 1 GiB RAM)

# --- SoC / platform ---
CONFIG_ARCH_REALTEK=y
CONFIG_ARCH_RTD129x=y
CONFIG_RESET_CONTROLLER=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- Initramfs / rescue rootfs boot ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y

# --- SATA (internal disk) ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SATA_HOST=y
CONFIG_SATA_AHCI=y
CONFIG_SATA_AHCI_PLATFORM=y
CONFIG_AHCI_RTD1295=y
CONFIG_PHY_RTK_RTD_SATAPHY=y

# --- Ethernet: RTD129x integrated GMAC (r8169soc) ---
CONFIG_R8169SOC=y
CONFIG_REALTEK_PHY=y
CONFIG_PHYLIB=y

# --- USB (rescue stick) ---
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_STORAGE=y

# --- Filesystems ---
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_TMPFS=y

# --- Networking / SSH ---
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# --- Device model / userspace ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FW_LOADER=y
# BINFMT_SCRIPT: without it the kernel panics "Failed to execute /init
# (error -8)" - /init is a #!/bin/sh script (learned the hard way, monarch)
CONFIG_BINFMT_SCRIPT=y
# PACKET (AF_PACKET): udhcpc cannot send DHCPDISCOVER without it
CONFIG_PACKET=y
# CRC16/CRC32: needed by ext4/GZIP before any module could load
CONFIG_CRC16=y
CONFIG_CRC32=y

# --- kexec (optional full Alpine boot) ---
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_KEXEC_CORE=y

# --- Scheduler tuning kept from the original WDMCH port ---
CONFIG_PSI=y
CONFIG_RCU_CPU_STALL_TIMEOUT=60

# --- CMA (required by cma_diag_race_shift_calls in this tree) ---
CONFIG_CMA=y
CONFIG_CMA_MIGRATION=y
CONFIG_CMA_DEBUGFS=y

# --- Build-time optimization: drop subsystems the rescue image never uses ---
# defconfig builds ~15k modules (nouveau, mlx5, iwlwifi, media, sound...),
# which dominates total build time. The rescue image needs none of them.
# Keep USB_STORAGE (rescue stick), R8169SOC (ethernet), AHCI_RTD1295 (SATA).
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_NFC is not set
# CONFIG_CAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_FB is not set
# CONFIG_AGP is not set
# CONFIG_INFINIBAND is not set
# CONFIG_STAGING is not set
# CONFIG_VFIO is not set
# CONFIG_PVPANIC is not set
# CONFIG_GREYBUS is not set
# CONFIG_COMEDI is not set
# CONFIG_ISDN is not set
# CONFIG_FIREWIRE is not set
# CONFIG_MACINTOSH_DRIVERS is not set
# CONFIG_AUXDISPLAY is not set
# CONFIG_RC_CORE is not set
# CONFIG_MEDIA_CEC_SUPPORT is not set
# CONFIG_LEDS_CLASS_FLASH is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_SOUNDWIRE is not set
# CONFIG_IMX_IPUV3_CORE is not
# CONFIG_MTD is not set
# CONFIG_PARPORT is not set
# CONFIG_NFC is not set
# CONFIG_TEGRA_HOST1X is not set
# CONFIG_GPU_VIRT is not set
# CONFIG_KVM is not set
