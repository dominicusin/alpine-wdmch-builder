# Build environment configuration
# Copy to config/build.env and fill in values
# NEVER commit config/build.env to version control

# SSH public key for root login (required for release builds)
# WDMCH_SSH_AUTHORIZED_KEY=ssh-rsa AAAAB3...

# Kernel configuration
# KERNEL_REF=<reviewed-commit-hash>

# Alpine version
# ALPINE_VERSION=3.21
